// GRIOT — Schéma de base de données (PostgreSQL via Prisma)
// Traduction directe du MCD défini dans GRIOT-Conception-SI.md
// Toutes les entités du dossier de conception sont représentées ici,
// même celles dont l'API n'est pas encore implémentée en Lot 1
// (cf. README.md pour la portée exacte du Lot 1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum RoleArbre {
  admin
  editeur
  contributeur
  lecteur
}

enum StatutMembre {
  actif
  invite
  en_attente
}

enum RoleInstitution {
  administrateur
  validateur
  lecteur
}

enum StatutMembreInstitution {
  actif
  invite
}

enum StatutUtilisateur {
  actif
  suspendu
  supprime
}

enum AvatarType {
  photo
  avatar_personnalise
  avatar_auto
  initiales
}

enum StatutVerification {
  non_verifie
  verifie_famille
  verifie_chefferie
}

enum CategorieSouvenir {
  histoire
  cuisine
  danse
  musique
  proverbe
  mariage
  funerailles
  naissance
  vetements
  rituel
}

enum TypeMedia {
  photo
  audio
  video
  document
}

enum TypeSource {
  autre
  acte_civil
  archive_nationale
  chefferie
  temoignage
  livre
  journal
  universite
  photo
  video
  entretien
}

enum FiabiliteSource {
  officielle
  institutionnelle
  familiale
  non_verifiee
}

enum StatutPreuve {
  en_attente
  validee
  rejetee
}

enum PerimetreSource {
  legacy_restreint
  arbre
  editorial
}

enum NatureDocumentaire {
  indeterminee
  primaire
  secondaire
  tertiaire
}

enum StatutDocumentaire {
  a_examiner
  source_identifiee
  contenu_extrait
  attente_verification
  verifie
  conteste
  obsolete
  archive
}

enum RoleDocumentaire {
  curateur
  validateur
  administrateur
}

enum TypeRelation {
  parent
  enfant
  conjoint
  pere
  mere
  fils
  fille
  frere
  soeur
  demi_frere
  demi_soeur
  grand_pere
  grand_mere
  petit_fils
  petite_fille
  arriere_grand_pere
  arriere_grand_mere
  arriere_petit_fils
  arriere_petite_fille
  oncle_maternel
  oncle_paternel
  tante_maternelle
  tante_paternelle
  neveu
  niece
  cousin
  cousine
  beau_pere
  belle_mere
  beau_fils
  belle_fille
  beau_frere
  belle_soeur
  autre
}

enum ThemeVisuel {
  moderne
  traditionnel_africain
  aquarelle
  minimaliste
  archives_anciennes
  royal
}

enum ActionSync {
  creation
  modification
  suppression
}

enum StatutSync {
  en_attente
  synchronise
  conflit
}

// ---------------------------------------------------------
// IDENTITY & TRUST (portée V1 — cf. §14 du dossier de conception)
// ---------------------------------------------------------

model Utilisateur {
  id                String            @id @default(uuid())
  nom               String
  prenom            String
  email             String            @unique
  telephone         String?           @unique
  motDePasseHash    String?
  langue            String            @default("fr")
  statut            StatutUtilisateur @default(actif)
  emailVerifie      Boolean           @default(false)
  telephoneVerifie  Boolean           @default(false)
  mfaActive         Boolean           @default(false)
  dateCreation      DateTime          @default(now())

  arbresPossedes    Arbre[]              @relation("proprietaire")
  membresArbre      MembreArbre[]
  membresInstitution MembreInstitution[]
  souvenirsCrees    Souvenir[]           @relation("auteur")
  commentairesSouvenirs CommentaireSouvenir[]
  preuvesCreees     Preuve[]             @relation("auteurPreuve")
  notifications     Notification[]
  syncQueue         SyncQueue[]
  preferences       PreferenceAffichage[]
  identitesModifiees IdentiteFamiliale[] @relation("modifiePar")
  identitesOAuth     IdentiteOAuth[]
  publicationsFamille PublicationFamille[]
  cartesLangue       CarteLangue[]
  habilitationsDocumentaires HabilitationDocumentaire[]

  @@map("utilisateurs")
}

model IdentiteOAuth {
  id            String      @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  fournisseur   String
  sujet         String
  dateCreation  DateTime    @default(now())

  @@unique([fournisseur, sujet])
  @@unique([utilisateurId, fournisseur])
  @@map("identites_oauth")
}

// ---------------------------------------------------------
// FAMILY MANAGEMENT
// ---------------------------------------------------------

model Arbre {
  id             String   @id @default(uuid())
  nom            String
  proprietaireId String
  proprietaire   Utilisateur @relation("proprietaire", fields: [proprietaireId], references: [id])
  visibilite     String   @default("prive")
  presentationPublique Boolean @default(false)
  introductionPublique String?
  languesPubliques String[] @default([])
  dateCreation   DateTime @default(now())

  membres              MembreArbre[]
  personnes            Personne[]
  souvenirs            Souvenir[]
  evenementsHistoriques EvenementHistorique[]
  missions             Mission[]
  institution          Institution?
  identiteFamiliale    IdentiteFamiliale?
  preferences          PreferenceAffichage[]
  publicationsFamille PublicationFamille[]
  cartesLangue        CarteLangue[]
  sourcesDocumentaires Source[]

  @@map("arbres")
}

model MembreArbre {
  id             String       @id @default(uuid())
  utilisateurId  String
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id])
  arbreId        String
  arbre          Arbre        @relation(fields: [arbreId], references: [id])
  role           RoleArbre    @default(lecteur)
  statut         StatutMembre @default(invite)
  dateInvitation DateTime     @default(now())

  @@unique([utilisateurId, arbreId])
  @@map("membres_arbre")
}

model PublicationFamille {
  id String @id @default(uuid())
  arbreId String
  arbre Arbre @relation(fields: [arbreId], references: [id], onDelete: Cascade)
  auteurId String
  auteur Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  parentId String?
  parent PublicationFamille? @relation("reponses", fields: [parentId], references: [id], onDelete: Cascade)
  reponses PublicationFamille[] @relation("reponses")
  theme String @default("discussion")
  contenu String
  dateCreation DateTime @default(now())
  @@index([arbreId, dateCreation])
  @@map("publications_famille")
}

model CarteLangue {
  id String @id @default(uuid())
  arbreId String
  arbre Arbre @relation(fields: [arbreId], references: [id], onDelete: Cascade)
  auteurId String
  auteur Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  langue String
  nomLangue String
  type String @default("mot")
  expression String
  traduction String
  explication String?
  source String
  validee Boolean @default(false)
  audio Bytes?
  audioMime String?
  dateCreation DateTime @default(now())
  @@index([arbreId, langue])
  @@map("cartes_langue")
}

// ---------------------------------------------------------
// GENEALOGY ENGINE
// ---------------------------------------------------------

model Personne {
  id              String     @id @default(uuid())
  arbreId         String
  arbre           Arbre      @relation(fields: [arbreId], references: [id])
  nom             String
  prenom          String
  dateNaissance   DateTime?
  dateDeces       DateTime?
  villageOrigine  String?
  avatarType      AvatarType @default(initiales)
  avatarCategorie String?
  avatarValeur    String?
  biographie      String?
  statutVerification StatutVerification @default(non_verifie)

  relationsSujet1 RelationFamiliale[] @relation("personne1")
  relationsSujet2 RelationFamiliale[] @relation("personne2")
  souvenirs       Souvenir[]
  medias          Media[]
  migrations      Migration[]
  preuves         Preuve[]

  @@map("personnes")
}

model RelationFamiliale {
  id           String       @id @default(uuid())
  personneId1  String
  personne1    Personne     @relation("personne1", fields: [personneId1], references: [id])
  personneId2  String
  personne2    Personne     @relation("personne2", fields: [personneId2], references: [id])
  typeRelation TypeRelation
  precision    String?

  @@map("relations_familiales")
}

// ---------------------------------------------------------
// HERITAGE MANAGEMENT
// ---------------------------------------------------------

model Souvenir {
  id                 String            @id @default(uuid())
  arbreId            String
  arbre              Arbre             @relation(fields: [arbreId], references: [id])
  personneId         String?
  personne           Personne?         @relation(fields: [personneId], references: [id])
  auteurId           String
  auteur             Utilisateur       @relation("auteur", fields: [auteurId], references: [id])
  categorie          CategorieSouvenir
  titre              String
  contenu            String?
  statutVerification StatutVerification @default(non_verifie)
  dateCreation       DateTime          @default(now())

  medias  Media[]
  preuves Preuve[]
  commentaires CommentaireSouvenir[]

  @@map("souvenirs")
}

model EvenementHistorique {
  id          String @id @default(uuid())
  arbreId     String
  arbre       Arbre  @relation(fields: [arbreId], references: [id])
  annee       String
  titre       String
  description String?

  @@map("evenements_historiques")
}

model Source {
  id         String          @id @default(uuid())
  type       TypeSource
  nom        String
  reference  String?
  fiabilite  FiabiliteSource @default(non_verifiee)
  perimetre PerimetreSource @default(legacy_restreint)
  arbreId String?
  arbre Arbre? @relation(fields: [arbreId], references: [id], onDelete: Restrict)
  auteurId String?
  auteurs String[] @default([])
  organisme String?
  categorieDocument String @default("autre")
  nature NatureDocumentaire @default(indeterminee)
  publication String?
  langueDocument String?
  url String?
  doi String?
  territoires String[] @default([])
  periode String?
  themes String[] @default([])
  licence String?
  droitsUsage String?
  statutDocumentaire StatutDocumentaire @default(a_examiner)
  publie Boolean @default(false)
  revision Int @default(1)
  cleDedup String? @unique
  dateCreation DateTime @default(now())
  dateModification DateTime @default(now())
  versions VersionSource[]
  consultations ConsultationSource[]
  journal JournalDocumentaire[]

  preuves Preuve[]

  @@index([arbreId, dateCreation, id])
  @@index([perimetre, publie, statutDocumentaire])

  @@map("sources")
}

model VersionSource {
  id String @id @default(uuid())
  sourceId String
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  numero Int
  metadonnees Json
  empreinteMetadonnees String
  motif String
  acteurId String
  dateCreation DateTime @default(now())
  consultations ConsultationSource[]
  @@unique([sourceId, numero])
  @@unique([id, sourceId])
  @@map("versions_source")
}

model ConsultationSource {
  id String @id @default(uuid())
  sourceId String
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  versionId String
  version VersionSource @relation(fields: [versionId, sourceId], references: [id, sourceId], onDelete: Restrict)
  acteurId String
  operation String
  accessibilite String
  contenuConsulte Boolean @default(false)
  provenance String @default("declaration_manuelle")
  note String?
  dateEnregistrement DateTime @default(now())
  @@index([sourceId, dateEnregistrement])
  @@map("consultations_source")
}

model JournalDocumentaire {
  id String @id @default(uuid())
  sourceId String
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  acteurId String
  action String
  revision Int
  motif String
  dateCreation DateTime @default(now())
  @@index([sourceId, dateCreation])
  @@map("journal_documentaire")
}

model HabilitationDocumentaire {
  id String @id @default(uuid())
  utilisateurId String
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  role RoleDocumentaire
  active Boolean @default(true)
  dateCreation DateTime @default(now())
  @@unique([utilisateurId, role])
  @@map("habilitations_documentaires")
}

model Preuve {
  id               String       @id @default(uuid())
  sourceId         String?
  source           Source?      @relation(fields: [sourceId], references: [id])
  personneId       String?
  personne         Personne?    @relation(fields: [personneId], references: [id])
  souvenirId       String?
  souvenir         Souvenir?    @relation(fields: [souvenirId], references: [id])
  type             String
  urlDocument      String?
  datePreuve       DateTime?
  auteurId         String
  auteur           Utilisateur  @relation("auteurPreuve", fields: [auteurId], references: [id])
  statutValidation StatutPreuve @default(en_attente)

  @@map("preuves")
}

// ---------------------------------------------------------
// MEDIA MANAGEMENT
// ---------------------------------------------------------

model Media {
  id          String    @id @default(uuid())
  souvenirId  String?
  souvenir    Souvenir? @relation(fields: [souvenirId], references: [id])
  personneId  String?
  personne    Personne? @relation(fields: [personneId], references: [id])
  type        TypeMedia
  url         String
  tailleOctets Int?
  dateUpload  DateTime  @default(now())

  @@map("medias")
}

model CommentaireSouvenir {
  id            String      @id @default(uuid())
  souvenirId    String
  souvenir      Souvenir    @relation(fields: [souvenirId], references: [id], onDelete: Cascade)
  auteurId      String
  auteur        Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  contenu       String
  dateCreation  DateTime    @default(now())

  @@index([souvenirId, dateCreation])
  @@map("commentaires_souvenirs")
}

// ---------------------------------------------------------
// GEOLOCALISATION / MIGRATIONS
// ---------------------------------------------------------

model Lieu {
  id        String  @id @default(uuid())
  nom       String
  pays      String?
  latitude  Float?
  longitude Float?

  migrations Migration[]

  @@map("lieux")
}

model Migration {
  id            String    @id @default(uuid())
  personneId    String
  personne      Personne  @relation(fields: [personneId], references: [id])
  lieuId        String
  lieu          Lieu      @relation(fields: [lieuId], references: [id])
  dateEvenement DateTime?
  ordre         Int       @default(0)

  @@map("migrations")
}

// ---------------------------------------------------------
// ENGAGEMENT (missions, notifications)
// ---------------------------------------------------------

model Mission {
  id             String    @id @default(uuid())
  arbreId        String
  arbre          Arbre     @relation(fields: [arbreId], references: [id])
  libelle        String
  complete       Boolean   @default(false)
  dateCompletion DateTime?

  @@map("missions")
}

model Notification {
  id            String   @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  type          String
  contenu       String
  cibleType     String?
  cibleId       String?
  arbreId       String?
  institutionId String?
  lue           Boolean  @default(false)
  dateCreation  DateTime @default(now())

  @@map("notifications")
}

// ---------------------------------------------------------
// OFFLINE & SYNCHRONIZATION
// ---------------------------------------------------------

model SyncQueue {
  id            String     @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  actionType    ActionSync
  payload       Json
  statut        StatutSync @default(en_attente)
  dateCreation  DateTime   @default(now())
  dateSync      DateTime?

  @@map("sync_queue")
}

// ---------------------------------------------------------
// VISUALIZATION ENGINE (personnalisation)
// ---------------------------------------------------------

model PreferenceAffichage {
  id                  String      @id @default(uuid())
  utilisateurId       String
  utilisateur         Utilisateur @relation(fields: [utilisateurId], references: [id])
  arbreId             String
  arbre               Arbre       @relation(fields: [arbreId], references: [id])
  themeVisuel         ThemeVisuel?
  avatarsActives      Boolean     @default(true)
  modeAvatarPrefere   String?
  densiteAffichage    String      @default("confortable")
  informationsVisibles Json?

  @@unique([utilisateurId, arbreId])
  @@map("preferences_affichage")
}

model IdentiteFamiliale {
  id                 String      @id @default(uuid())
  arbreId            String      @unique
  arbre              Arbre       @relation(fields: [arbreId], references: [id])
  blasonUrl          String?
  banniereUrl        String?
  devise             String?
  themeOfficiel      ThemeVisuel @default(moderne)
  paletteCouleurs    String?
  styleAvatarDefaut  String?
  modifieParId       String
  modifiePar         Utilisateur @relation("modifiePar", fields: [modifieParId], references: [id])
  dateModification   DateTime    @updatedAt

  @@map("identites_familiales")
}

// ---------------------------------------------------------
// GOVERNANCE — Institution (chefferie)
// ---------------------------------------------------------

model Institution {
  id                 String @id @default(uuid())
  arbreId            String @unique
  arbre              Arbre  @relation(fields: [arbreId], references: [id])
  nom                String
  type               String
  statutVerification StatutVerification @default(non_verifie)
  membres             MembreInstitution[]

  @@map("institutions")
}

model MembreInstitution {
  id             String                @id @default(uuid())
  institutionId  String
  institution    Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur           @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role           RoleInstitution       @default(lecteur)
  statut         StatutMembreInstitution @default(invite)
  dateInvitation DateTime              @default(now())

  @@unique([institutionId, utilisateurId])
  @@index([utilisateurId, statut])
  @@map("membres_institution")
}
